<StatusMessage Message="@StatusMessage" />
<h3>Recovery codes</h3>
@* Koderna lagras hashade, precis som lösenord. Servern kan därför aldrig visa
   dem igen, bara avgöra om en inskriven kod stämmer. Det är värt att säga rakt
   ut här, för det är enda tillfället användaren ser dem. *@
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Put these codes in a safe place. This is the only time they are shown.</strong>
    </p>
    <p>
        They are stored hashed, so they cannot be displayed again. Each code works exactly once.
    </p>
    <p>
        If you lose your device and don't have the recovery codes you will lose access to your account.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
